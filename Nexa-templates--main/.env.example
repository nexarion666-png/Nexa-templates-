# Copy to .env.local for local development. NEVER commit .env.local or real values.
# In production set these in Vercel -> Project -> Settings -> Environment Variables.

# --- Supabase (Stage 4) — both values are PUBLIC and safe in the browser; row security protects the data ---
# Project URL, e.g. https://abcdefghijkl.supabase.co  (Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" / publishable key (NOT the service-role / secret key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, OFF by default. Set to "static" to serve the hardcoded lib/products.ts catalogue ONLY while the
# two variables above are missing. It never masks a database outage once Supabase is configured.
# NEXA_CATALOGUE_FALLBACK=static

# --- Reserved for later stages (leave empty now). Never prefix secrets with NEXT_PUBLIC_. ---
SUPABASE_SERVICE_ROLE_KEY=
DOWNLOAD_SIGNING_SECRET=

# --- Stripe (Phase 11) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public site origin, no trailing slash, e.g. https://your-site.vercel.app
NEXT_PUBLIC_SITE_URL=
# Stripe webhook: endpoint https://<NEXT_PUBLIC_SITE_URL>/api/webhooks/stripe , event checkout.session.completed
